      "keywords_file": ".claude/blog/data/keywords-es.json",
      "briefs_dir": ".claude/blog/data/briefs-es/",
      "articles_dir": "content/es-ES/blog/",
      "auto_flow_schedule": "bi-weekly"
    }
  },
  "stockpile": {
    "enabled": false,
    "target_groups_per_run": 35,
    "min_groups_for_promote_only": 5,
    "allow_promote_only_mode": true,
    "enforce_hreflang_pair_in_promote": true,
    "enforce_hreflang_pair_in_legacy_publish": false,
    "volatility_default_class": "vendor",
    "freshness_gate_enabled": true,
    "lock_ttl_minutes": 45,
    "package_lock_ttl_minutes": 10,
    "block_contents_api_for_stockpile": true,
    "archive_promoted_after_days": 0
  },
  "hub_spoke": {
    "universal_tags": ["nextjs", "software-development", "automation"],
    "require_hreflang_pair": true,
    "exclusive_markets": ["br", "it", "en", "es"]
  },
  "deploy": {
    "velite_rebuild": true,
    "ci_trigger": "github-actions",
    "build_command_by_market": {
      "br": "npm run build:br",
      "it": "npm run build:it",
      "en": "npm run build:en",
      "es": "npm run build:es"
    }
  }
}
