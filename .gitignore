# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.velite/
/static/
/__next.*.txt
/_next/
/privacidade/
/servicos/
/robots.txt
/search-index.json
/sitemap.xml

# production
/build

# multi-locale static builds (generated by npm run build:br/it/en)
/dist-br/
/dist-it/
/dist-en/
/dist-es/

# build reports
/docs/BROKEN-LINKS-AUDIT.md

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Test users credentials (generated by /create-test-user)
# NOTA: Este é um projeto sem autenticação. Estes arquivos documentam
# pontos de contato para testes manuais, mas não contêm credenciais reais.
test-users.md
test-users.json

# Deployment documentation (pode conter referências a secrets)
# Use GitHub Secrets ou .env para manter credenciais seguras
DEPLOYMENT.md

# Stockpile lock files (estado efêmero local; nunca versionar)
.claude/blog/data/stockpile/.run-lock.json
.claude/blog/data/stockpile/packages/*/.lock.json
