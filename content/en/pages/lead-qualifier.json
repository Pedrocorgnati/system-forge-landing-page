      "autocomplete": "email",
      "hint": "We use it to send scope and budget."
    },
    "company": {
      "label": "Company",
      "placeholder": "Legal name or brand",
      "autocomplete": "organization"
    },
    "softwareType": {
      "label": "Software type",
      "placeholder": "Select project type",
      "options": [
        { "value": "sob-medida", "label": "Custom software" },
        { "value": "erp-nichado", "label": "Vertical ERP" },
        { "value": "automacao-ia", "label": "AI automation" },
        { "value": "outro", "label": "Other" }
      ]
    },
    "urgency": {
      "label": "Urgency",
      "options": [
        { "value": "1-mes", "label": "Next 1 month" },
        { "value": "3-meses", "label": "Next 3 months" },
