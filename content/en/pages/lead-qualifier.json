    },
    "company": {
      "required": "Enter the company name.",
      "max": "Company name too long (maximum 160 characters)."
    },
    "softwareType": {
      "required": "Select the software type."
    },
    "urgency": {
      "required": "Select the project urgency."
    },
    "budget": {
      "required": "Select the investment range."
    },
    "channel": {
      "required": "Select the preferred response channel."
    },
