{
  "name": "system-forge-landing-page",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build:content": "velite build",
    "generate:search-index": "node --import tsx scripts/generate-search-index.ts",
    "validate:frontmatter": "tsx scripts/validate-frontmatter.ts",
    "validate:hreflang": "tsx scripts/hreflang-validator.ts",
    "validate:sitemap-hreflang": "tsx scripts/validate-hreflang-sitemaps.ts",
    "validate:jsonld": "tsx scripts/validate-jsonld.ts",
    "validate:hreflang-pages": "tsx scripts/validate-hreflang-pages.ts",
    "prebuild:br": "NEXT_PUBLIC_LOCALE=pt-BR npm run build:content && NEXT_PUBLIC_LOCALE=pt-BR npm run generate:search-index && cp config/manifests/manifest.br.json public/manifest.json && NEXT_PUBLIC_LOCALE=pt-BR tsx scripts/validate-frontmatter.ts",
    "prebuild:it": "NEXT_PUBLIC_LOCALE=it-IT npm run build:content && NEXT_PUBLIC_LOCALE=it-IT npm run generate:search-index && cp config/manifests/manifest.it.json public/manifest.json && NEXT_PUBLIC_LOCALE=it-IT tsx scripts/validate-frontmatter.ts",
    "prebuild:en": "NEXT_PUBLIC_LOCALE=en npm run build:content && NEXT_PUBLIC_LOCALE=en npm run generate:search-index && cp config/manifests/manifest.en.json public/manifest.json && NEXT_PUBLIC_LOCALE=en tsx scripts/validate-frontmatter.ts",
    "prebuild:es": "NEXT_PUBLIC_LOCALE=es-ES npm run build:content && NEXT_PUBLIC_LOCALE=es-ES npm run generate:search-index && cp config/manifests/manifest.es.json public/manifest.json && NEXT_PUBLIC_LOCALE=es-ES tsx scripts/validate-frontmatter.ts",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "type-check": "tsc --noEmit",
    "prebuild": "npm run build:content && npm run generate:search-index && ([ -f public/manifest.json ] || cp config/manifests/manifest.en.json public/manifest.json)",
    "build": "next build",
    "build:br": "NEXT_PUBLIC_LOCALE=pt-BR NEXT_PUBLIC_SITE_URL=https://forjadesistemas.com.br OUT_DIR=dist-br next build",
    "build:it": "NEXT_PUBLIC_LOCALE=it-IT NEXT_PUBLIC_SITE_URL=https://systemforge.it OUT_DIR=dist-it next build",
    "build:en": "NEXT_PUBLIC_LOCALE=en NEXT_PUBLIC_SITE_URL=https://systemforgesoftware.com OUT_DIR=dist-en next build",
    "build:es": "NEXT_PUBLIC_LOCALE=es-ES NEXT_PUBLIC_SITE_URL=https://systemforge.es OUT_DIR=dist-es next build",
    "smoke:seo": "npm run build:br && npm run build:it && npm run build:en && npm run build:es && npm run validate:sitemap-hreflang",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "test:mutation:quick": "stryker run --mutate 'src/lib/i18n.ts'",
    "analyze": "ANALYZE=true npm run build:br",
    "optimize:og-images": "bash scripts/optimize-og-images.sh",
    "lighthouse:br": "npx serve dist-br/ -p 3001 & sleep 3 && npx lighthouse http://localhost:3001 --output=json",
    "lighthouse:it": "npx serve dist-it/ -p 3002 & sleep 3 && npx lighthouse http://localhost:3002 --output=json",
    "lighthouse:en": "npx serve dist-en/ -p 3003 & sleep 3 && npx lighthouse http://localhost:3003 --output=json",
    "docker:dev": "docker compose up",
    "docker:dev:build": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:clean": "docker compose down -v",
    "docker:build:br": "docker build --build-arg LOCALE=br -t system-forge-landing-page:br .",
    "docker:build:it": "docker build --build-arg LOCALE=it -t system-forge-landing-page:it .",
    "docker:build:en": "docker build --build-arg LOCALE=en -t system-forge-landing-page:en .",
    "setup": "./scripts/bootstrap.sh",
    "reset": "./scripts/bootstrap.sh --reset",
    "test:load:smoke": "k6 run --env SCENARIO=smoke tests/load/run-all.js",
    "test:load": "k6 run tests/load/run-all.js",
    "test:load:stress": "k6 run --env SCENARIO=stress tests/load/run-all.js",
    "test:load:i18n:smoke": "k6 run --env SCENARIO=smoke tests/load/run-all-i18n.js",
    "test:load:i18n": "k6 run tests/load/run-all-i18n.js",
    "test:load:i18n:it": "k6 run --env MARKET=it tests/load/run-all-i18n.js",
    "test:load:i18n:en": "k6 run --env MARKET=en tests/load/run-all-i18n.js",
    "validate:stockpile": "tsx src/lib/blog/validate-stockpile.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "glob": "^11.0.3",
    "lucide-react": "^1.0.1",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "oidc-client-ts": "^3.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "velite": "^0.3.1",
    "web-vitals": "^5.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@next/bundle-analyzer": "^15.5.14",
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "jsdom": "^29.0.1",
    "serve": "^14.2.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
