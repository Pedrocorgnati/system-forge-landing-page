{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/lib/i18n.ts",
    "src/lib/locale-slugs.ts",
    "src/lib/content/content-loader.ts",
    "src/lib/sitemap.ts",
    "src/lib/robots.ts",
    "src/lib/blog/post-schema.ts",
    "src/lib/services/newsletter.ts",
    "src/lib/analytics.ts",
    "src/components/LanguageSuggestionBanner.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.integration.test.ts",
    "!src/**/*.d.ts",
    "!src/__tests__/**",
    "!src/__mocks__/**"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 40
  },
  "timeoutMS": 60000,
  "concurrency": 4,
  "incremental": true,
  "incrementalFile": ".stryker-incremental.json",
  "vitest": {
    "configFile": "vitest.config.ts"
  }
}
