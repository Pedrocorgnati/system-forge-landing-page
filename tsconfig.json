{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@config": [
        "./config/index"
      ],
      "@config/*": [
        "./config/*"
      ],
      "config/sites": [
        "./config/sites/index.ts"
      ],
      "config/sites/*": [
        "./config/sites/*"
      ],
      "@content/*": [
        "./content/*"
      ],
      "@/.velite": [
        "./.velite/index"
      ],
      "#site/*": [
        "./.velite/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "cloudflare-worker",
    "workers",
    "scripts"
  ]
}